    %vpi_call/w 3 59 "$display", "  r1 = %d (Expected 150)", &A<v0x5be1122257a0, 1> {0 0 0};
    %vpi_call/w 3 60 "$display", "  r2 = %d (Expected 350)", &A<v0x5be1122257a0, 2> {0 0 0};
    %vpi_call/w 3 61 "$display", "  r3 = %d (Expected 500)", &A<v0x5be1122257a0, 3> {0 0 0};
    %vpi_call/w 3 62 "$display", "  r5 = %d (Expected 650)", &A<v0x5be1122257a0, 5> {0 0 0};
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %load/vec4a v0x5be1122257a0, 4;
    %pushi/vec4 150, 0, 64;
    %cmp/e;
    %flag_get/vec4 6;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %load/vec4a v0x5be1122257a0, 4;
    %pushi/vec4 350, 0, 64;
    %cmp/e;
    %flag_get/vec4 6;
    %and;
    %ix/load 4, 3, 0;
    %flag_set/imm 4, 0;
    %load/vec4a v0x5be1122257a0, 4;
    %pushi/vec4 500, 0, 64;
    %cmp/e;
    %flag_get/vec4 6;
    %and;
    %ix/load 4, 5, 0;
    %flag_set/imm 4, 0;
    %load/vec4a v0x5be1122257a0, 4;
    %pushi/vec4 650, 0, 64;
    %cmp/e;
    %flag_get/vec4 6;
    %and;
    %flag_set/vec4 8;
    %jmp/0xz  T_24.2, 8;
    %vpi_call/w 3 68 "$display", "ARITHMETIC_ASSERTION_PASS: ALU ADDITIONS & REGISTER FORWARDING VERIFIED" {0 0 0};
    %vpi_call/w 3 69 "$finish" {0 0 0};
    %jmp T_24.3;
T_24.2 ;
    %vpi_call/w 3 71 "$display", "FAIL: ARITHMETIC REGFILE MISMATCH" {0 0 0};
    %vpi_call/w 3 72 "$fatal", 32'sb00000000000000000000000000000001, "Mismatch" {0 0 0};
T_24.3 ;
    %end;
    .thread T_24;
